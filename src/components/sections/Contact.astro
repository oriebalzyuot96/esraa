---
import { CONTACT, PERSON } from '../../data/profile';
const lang = Astro.currentLocale === 'ar' ? 'ar' : 'en';
const L = (o: Record<string, string>) => o[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class="sec" id="contact" aria-labelledby="contactT">
  <div class="wrap">
    <div class="card contact reveal">
      <div class="avatars"><img src={`${base}assets/esraa-face.jpg`} alt="" width="96" height="96"></div>
      <h2 id="contactT">{L(CONTACT.t)}</h2>
      <p>{L(CONTACT.p)}</p>
      <div class="c-grid c-grid-3">
        <div class="c-card"><small>Email</small><a class="ltr" href={`mailto:${PERSON.email}`}><span>{PERSON.email}</span></a><button class="copy" data-copy={PERSON.email}>{L(CONTACT.copy)}</button></div>
        <a class="c-card" href={`tel:${PERSON.phone.replace(/\s/g, '')}`}><small>{lang === 'ar' ? 'الهاتف' : 'Phone'}</small><span class="ltr">{PERSON.phone}</span></a>
        <a class="c-card" href={PERSON.linkedin} target="_blank" rel="noopener"><small>LinkedIn</small><span class="ltr">in/esraa-nasser ↗</span></a>
      </div>
      <div class="avail">{CONTACT.avail.map(a => <span>{L(a)}</span>)}</div>
    </div>
  </div>
</section>
